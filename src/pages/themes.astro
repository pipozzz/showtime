---
import Layout from '../components/Layout.astro';
import '../story/story.css';
import { THEMES } from '../themes';
import { store } from '../lib/profiles';
import { link } from '../lib/url';

const sample = (await store.list())[0];
const [first, ...rest] = (sample?.profile.name ?? 'Your Name').split(' ');
---
<Layout title="Themes — Showtime" description="Every Showtime theme, made by the community.">
  <header class="th-head">
    <a class="mono accent" href={link()}>← Showtime</a>
    <h1 class="display">Themes<span class="accent">.</span></h1>
    <p class="pitch">
      {THEMES.length} stages, one YAML line: <code class="mono">theme: {THEMES[1]?.id ?? 'acid'}</code>.
      Every theme is a folder in <code class="mono">src/themes/</code> — make your own in a few minutes.
    </p>
    <a class="btn" href="https://github.com/pipozzz/showtime/blob/main/CONTRIBUTING.md#add-a-theme">Make a theme →</a>
  </header>

  <ul class="th-grid">
    {THEMES.map((t) => (
      <li data-theme={t.id} class="story th-card">
        <div class="hero th-hero">
          <div class="hero-top mono"><span>{t.name}</span><span class="tag solid">{t.scheme}</span></div>
          <h2 class="display hero-name th-name">
            <span class="line">{first}</span>
            <span class="line accent">{rest.join(' ')}</span>
          </h2>
          <div class="th-impact">
            <span class="display accent">18M visits</span>
            <span class="redacted"><span>classified</span> <span>internal url</span></span>
          </div>
        </div>
        <div class="th-meta">
          <p>{t.description}</p>
          <p class="mono muted">
            by {t.author.url ? <a href={t.author.url}>{t.author.name}</a> : t.author.name} · <code>theme: {t.id}</code>
          </p>
          <div class="th-actions">
            <a class="btn" href={link(`edit?from=${sample?.handle ?? ''}&theme=${t.id}`)}>Try in editor</a>
            <a class="btn ghost" href={`https://github.com/pipozzz/showtime/tree/main/src/themes/${t.id}`}>Source</a>
          </div>
        </div>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .th-head { padding: 12vh var(--gutter) 8vh; display: grid; gap: 24px; justify-items: start; }
  .th-head a.mono { text-decoration: none; }
  .th-head h1 { font-size: clamp(80px, 14vw, 220px); }
  .pitch { font-size: clamp(18px, 2vw, 26px); max-width: 44ch; }
  code { font-family: var(--mono); font-size: .85em; background: var(--line); padding: 1px 6px; }
  .btn {
    font-family: var(--mono); text-transform: uppercase; font-size: 13px; letter-spacing: .05em;
    padding: 13px 18px; background: var(--accent); color: var(--accent-ink); text-decoration: none; display: inline-block;
  }
  .btn.ghost { background: transparent; color: var(--fg); box-shadow: inset 0 0 0 1px var(--line); }
  .th-grid {
    list-style: none; padding: 0 var(--gutter) 16vh;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 520px), 1fr)); gap: 24px;
  }
  .th-card { border: 1px solid var(--line); display: grid; overflow: hidden; }
  .th-hero.hero { min-height: 0; padding: 40px 44px 44px; gap: 18px; }
  .th-name.hero-name { font-size: clamp(48px, 13cqi, 120px); }
  .th-impact { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
  .th-impact .display { font-size: 32px; }
  .th-meta { padding: 20px 24px 24px; border-top: 1px solid var(--line); display: grid; gap: 10px; }
  .th-meta a { color: var(--accent); }
  .th-meta code { background: var(--line); }
  .th-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px; }
  .th-actions .btn { color: var(--accent-ink); }
  .th-actions .btn.ghost { color: var(--fg); }
</style>
