---
import Layout from '../components/Layout.astro';
import Editor from '../editor/Editor';
import { store } from '../lib/profiles';

const samples = await store.list();
---
<Layout title="Editor — Starring" description="Build your Starring profile visually." bare noindex>
  <Editor client:only="react" samples={samples} />
  <noscript><p style="padding:24px">The editor needs JavaScript. You can also edit a YAML file in <code>profiles/</code>.</p></noscript>
</Layout>
