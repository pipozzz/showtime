---
import Layout from '../../components/Layout.astro';
import { getSession, instance, signupOffered } from '../auth';
import { link } from '../../lib/url';

export const prerender = false;

// Only same-site paths as the post-login destination.
const nextParam = Astro.url.searchParams.get('next') ?? '';
const next = /^\/(?!\/)/.test(nextParam) ? nextParam : link('edit');

if (await getSession(Astro.request)) return Astro.redirect(next);

const canOfferSignup = await signupOffered();
const mode = Astro.url.searchParams.get('mode') === 'signup' && canOfferSignup ? 'signup' : 'signin';
const social = [instance.github && { id: 'github', label: 'GitHub' }, instance.gitlab && { id: 'gitlab', label: 'GitLab' }].filter(Boolean) as { id: string; label: string }[];
---
<Layout title={mode === 'signup' ? 'Claim your stage — Starring' : 'Sign in — Starring'} fonts={['acid']} noindex>
  <main class="auth" data-next={next} data-mode={mode} data-verify={instance.requireVerification ? '1' : ''} data-verified={`${link('login')}?verified`}>
    <a class="mono accent back" href={link()}>← Starring</a>
    {Astro.url.searchParams.has('reset') && <p class="notice mono">Password changed — sign in with the new one.</p>}
    {Astro.url.searchParams.has('verified') && <p class="notice mono">Email confirmed.</p>}
    <h1 class="display">{mode === 'signup' ? <>Claim your<br /><span class="accent">stage.</span></> : <>Welcome<br /><span class="accent">back.</span></>}</h1>

    {social.length > 0 && (
      <div class="social">
        {social.map((s) => (
          <button type="button" class="btn ghost" data-provider={s.id}>Continue with {s.label}</button>
        ))}
      </div>
    )}

    {instance.passwordLogin && (
      <form class="form" novalidate>
        {social.length > 0 && <p class="mono muted or">or with email</p>}
        <label class="field signup-only"><span class="mono">Name</span><input name="name" autocomplete="name" /></label>
        <label class="field"><span class="mono">Email</span><input name="email" type="email" autocomplete="email" required /></label>
        <label class="field">
          <span class="mono">Password</span>
          <input name="password" type="password" minlength="10" required autocomplete={mode === 'signup' ? 'new-password' : 'current-password'} />
          <span class="hint signup-only">At least 10 characters.</span>
          <a class="hint signin-only forgot" href={link('forgot-password')}>Forgot password?</a>
        </label>
        <p class="error" role="alert" hidden></p>
        {mode === 'signup' && <p class="hint">By creating an account you agree to the <a href={link('terms')}>Terms</a> and <a href={link('privacy')}>Privacy notice</a>.</p>}
        <button class="btn" type="submit">{mode === 'signup' ? 'Create account →' : 'Sign in →'}</button>
      </form>
    )}

    <p class="switch">
      {mode === 'signup'
        ? <>Already have a stage? <a href={`${link('login')}?next=${encodeURIComponent(next)}`}>Sign in</a></>
        : canOfferSignup
          ? <>New here? <a href={`${link('login')}?mode=signup&next=${encodeURIComponent(next)}`}>Create an account</a></>
          : <span class="muted">Sign-ups are closed on this instance.</span>}
    </p>
  </main>
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('.auth')!;
  const next = root.dataset.next!;
  const signup = root.dataset.mode === 'signup';
  const api = (path: string, body: object) =>
    fetch(`/api/auth/${path}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body), credentials: 'same-origin' });

  document.querySelectorAll<HTMLButtonElement>('[data-provider]').forEach((b) =>
    b.addEventListener('click', async () => {
      b.disabled = true;
      const res = await api('sign-in/social', { provider: b.dataset.provider, callbackURL: next });
      const data = await res.json().catch(() => ({}));
      if (data.url) location.href = data.url;
      else b.disabled = false;
    }),
  );

  const form = document.querySelector<HTMLFormElement>('.form');
  const error = form?.querySelector<HTMLElement>('.error');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const email = String(f.get('email') ?? '').trim();
    const password = String(f.get('password') ?? '');
    const name = String(f.get('name') ?? '').trim() || email.split('@')[0];
    const show = (msg: string) => { error!.textContent = msg; error!.hidden = !msg; };
    if (!email || !password) return show('Email and password are required.');
    if (signup && password.length < 10) return show('Use at least 10 characters for the password.');
    show('');
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    btn.disabled = true;
    const res = await api(signup ? 'sign-up/email' : 'sign-in/email', signup ? { name, email, password, callbackURL: root.dataset.verified } : { email, password });
    if (res.ok && signup && root.dataset.verify) {
      form.innerHTML = `<p class="notice">Almost there — we sent a confirmation link to <b>${email.replace(/[<>&]/g, '')}</b>. Open it to finish signing up.</p>`;
      return;
    }
    if (res.ok) return location.assign(next);
    const data = await res.json().catch(() => ({}));
    btn.disabled = false;
    show(data.message || (res.status === 429 ? 'Too many attempts — wait a minute.' : 'That didn’t work. Check your email and password.'));
  });
</script>

<style>
  .auth { min-height: 100svh; display: grid; align-content: center; gap: 28px; padding: 10vh var(--gutter); max-width: 560px; margin: 0 auto; }
  .back { text-decoration: none; }
  h1 { font-size: clamp(64px, 12vw, 120px); }
  .social { display: grid; gap: 10px; }
  .form { display: grid; gap: 16px; }
  .or { text-align: center; }
  .field { display: grid; gap: 6px; }
  .field .mono { color: var(--muted); }
  .field input {
    background: transparent; border: 1px solid var(--line); color: var(--fg);
    font: inherit; padding: 14px 14px; border-radius: 0;
  }
  .field input:focus { outline: none; border-color: var(--accent); }
  .hint { font-size: 13px; color: var(--muted); }
  [data-mode='signin'] .signup-only { display: none; }
  [data-mode='signup'] .signin-only { display: none; }
  .forgot { color: var(--accent); justify-self: end; }
  .hint a { color: var(--accent); }
  .notice { color: var(--accent); }
  .error { color: #ff6b5e; }
  .btn {
    font-family: var(--mono); text-transform: uppercase; letter-spacing: .05em; font-size: 14px;
    padding: 16px 20px; border: 0; cursor: pointer; background: var(--accent); color: var(--accent-ink);
  }
  .btn.ghost { background: transparent; color: var(--fg); box-shadow: inset 0 0 0 1px var(--line); }
  .btn:disabled { opacity: .5; cursor: progress; }
  .switch a { color: var(--accent); }
</style>
