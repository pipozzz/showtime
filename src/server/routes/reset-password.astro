---
import Layout from '../../components/Layout.astro';
import { link } from '../../lib/url';

export const prerender = false;
// Better Auth redirects here with ?token=… (valid) or ?error=INVALID_TOKEN (expired/used).
const token = Astro.url.searchParams.get('token') ?? '';
const invalid = !token || Astro.url.searchParams.get('error') === 'INVALID_TOKEN';
---
<Layout title="New password — Starring" fonts={['acid']} noindex>
  <main class="auth" data-token={token} data-login={link('login')}>
    <a class="mono accent back" href={link('login')}>← Sign in</a>
    <h1 class="display">New<br /><span class="accent">password.</span></h1>
    {invalid ? (
      <p class="error">This reset link is invalid or has expired. <a href={link('forgot-password')}>Send a new one</a>.</p>
    ) : (
      <form class="form" novalidate>
        <label class="field">
          <span class="mono">New password</span>
          <input name="password" type="password" minlength="10" autocomplete="new-password" required autofocus />
          <span class="hint">At least 10 characters. You'll be signed out everywhere else.</span>
        </label>
        <p class="error" role="alert" hidden></p>
        <button class="btn" type="submit">Set password →</button>
      </form>
    )}
  </main>
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('.auth')!;
  const form = root.querySelector<HTMLFormElement>('.form');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const newPassword = String(new FormData(form).get('password') ?? '');
    const err = form.querySelector<HTMLElement>('.error')!;
    if (newPassword.length < 10) { err.textContent = 'Use at least 10 characters.'; err.hidden = false; return; }
    const btn = form.querySelector('button')!;
    btn.disabled = true;
    const res = await fetch('/api/auth/reset-password', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
      body: JSON.stringify({ newPassword, token: root.dataset.token }),
    });
    if (res.ok) return location.assign(`${root.dataset.login}?reset=1`);
    const data = await res.json().catch(() => ({}));
    btn.disabled = false;
    err.textContent = data.message || 'That link no longer works — request a new one.';
    err.hidden = false;
  });
</script>

<style>
  .ok { color: var(--accent); font-size: 18px; }
  .error a { color: var(--accent); }
  .auth { min-height: 100svh; display: grid; align-content: center; gap: 28px; padding: 10vh var(--gutter); max-width: 560px; margin: 0 auto; }
  .back { text-decoration: none; }
  h1 { font-size: clamp(64px, 12vw, 120px); }
  .social { display: grid; gap: 10px; }
  .form { display: grid; gap: 16px; }
  .or { text-align: center; }
  .field { display: grid; gap: 6px; }
  .field .mono { color: var(--muted); }
  .field input {
    background: transparent; border: 1px solid var(--line); color: var(--fg);
    font: inherit; padding: 14px 14px; border-radius: 0;
  }
  .field input:focus { outline: none; border-color: var(--accent); }
  .hint { font-size: 13px; color: var(--muted); }
  [data-mode='signin'] .signup-only { display: none; }
  .error { color: #ff6b5e; }
  .btn {
    font-family: var(--mono); text-transform: uppercase; letter-spacing: .05em; font-size: 14px;
    padding: 16px 20px; border: 0; cursor: pointer; background: var(--accent); color: var(--accent-ink);
  }
  .btn.ghost { background: transparent; color: var(--fg); box-shadow: inset 0 0 0 1px var(--line); }
  .btn:disabled { opacity: .5; cursor: progress; }
  .switch a { color: var(--accent); }
</style>
