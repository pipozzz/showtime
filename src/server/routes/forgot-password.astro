---
import Layout from '../../components/Layout.astro';
import { instance } from '../auth';
import { link } from '../../lib/url';

export const prerender = false;
const sent = Astro.url.searchParams.has('sent');
---
<Layout title="Forgot password — Starring" fonts={['acid']} noindex>
  <main class="auth" data-reset={link('reset-password')}>
    <a class="mono accent back" href={link('login')}>← Sign in</a>
    <h1 class="display">Forgot<br /><span class="accent">password?</span></h1>
    {!instance.mail && <p class="muted">Email isn't set up on this instance yet — ask its owner to reset your password.</p>}
    {sent ? (
      <p class="ok">If an account exists for that address, a reset link is on its way. It works for one hour — check spam too.</p>
    ) : (
      <form class="form" novalidate>
        <label class="field"><span class="mono">Email</span><input name="email" type="email" autocomplete="email" required autofocus /></label>
        <p class="error" role="alert" hidden></p>
        <button class="btn" type="submit">Send reset link →</button>
      </form>
    )}
  </main>
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('.auth')!;
  const form = root.querySelector<HTMLFormElement>('.form');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = String(new FormData(form).get('email') ?? '').trim();
    const err = form.querySelector<HTMLElement>('.error')!;
    if (!email) { err.textContent = 'Enter your email.'; err.hidden = false; return; }
    const btn = form.querySelector('button')!;
    btn.disabled = true;
    const res = await fetch('/api/auth/request-password-reset', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
      body: JSON.stringify({ email, redirectTo: root.dataset.reset }),
    });
    // Same answer whether or not the account exists, so this can't be used to probe emails.
    if (res.ok || res.status === 400 || res.status === 404) return location.assign(`${location.pathname}?sent`);
    btn.disabled = false;
    err.textContent = res.status === 429 ? 'Too many attempts — wait a minute.' : 'Something went wrong. Try again.';
    err.hidden = false;
  });
</script>

<style>
  .ok { color: var(--accent); font-size: 18px; }
  .error a { color: var(--accent); }
  .auth { min-height: 100svh; display: grid; align-content: center; gap: 28px; padding: 10vh var(--gutter); max-width: 560px; margin: 0 auto; }
  .back { text-decoration: none; }
  h1 { font-size: clamp(64px, 12vw, 120px); }
  .social { display: grid; gap: 10px; }
  .form { display: grid; gap: 16px; }
  .or { text-align: center; }
  .field { display: grid; gap: 6px; }
  .field .mono { color: var(--muted); }
  .field input {
    background: transparent; border: 1px solid var(--line); color: var(--fg);
    font: inherit; padding: 14px 14px; border-radius: 0;
  }
  .field input:focus { outline: none; border-color: var(--accent); }
  .hint { font-size: 13px; color: var(--muted); }
  [data-mode='signin'] .signup-only { display: none; }
  .error { color: #ff6b5e; }
  .btn {
    font-family: var(--mono); text-transform: uppercase; letter-spacing: .05em; font-size: 14px;
    padding: 16px 20px; border: 0; cursor: pointer; background: var(--accent); color: var(--accent-ink);
  }
  .btn.ghost { background: transparent; color: var(--fg); box-shadow: inset 0 0 0 1px var(--line); }
  .btn:disabled { opacity: .5; cursor: progress; }
  .switch a { color: var(--accent); }
</style>
