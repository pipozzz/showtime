{
  "name": "showtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Your developer career as a scroll story. Public repos, private client work, CV — one YAML file.",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "new:theme": "node scripts/new-theme.mjs",
    "dev:server": "SHOWTIME_MODE=server astro dev",
    "build:server": "SHOWTIME_MODE=server astro build",
    "start": "node scripts/migrate.mjs && node dist/server/entry.mjs",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.1",
    "better-auth": "^1.7.11",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
