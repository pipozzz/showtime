# ---- required in server mode -------------------------------------------
# Public URL of this instance (used for auth callbacks and canonical links)
BETTER_AUTH_URL=http://localhost:4321
SITE_URL=http://localhost:4321
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Postgres password used by docker-compose.yml (the app gets DATABASE_URL from compose)
POSTGRES_PASSWORD=change-me
# Outside compose, point the app at Postgres yourself:
# DATABASE_URL=postgres://starring:starring@127.0.0.1:5440/starring

# ---- instance policy -----------------------------------------------------
# false = only existing accounts can sign in (private / invite-only instance)
ALLOW_SIGNUP=true
# with ALLOW_SIGNUP=false: emails that may still sign up (the first account on an empty instance always can)
SIGNUP_ALLOWLIST=
# false = OAuth only, no email + password
AUTH_PASSWORD=true

# ---- email (password reset, address verification) ----------------------
# nodemailer over any SMTP server: your own (Postfix, Mailcow…), Google Workspace,
# Zoho, Fastmail, your hosting's mailbox… Without SMTP_HOST, reset links are only
# printed to the server log in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true = implicit TLS (port 465); otherwise STARTTLS when the server offers it
SMTP_SECURE=
# …or everything in one URL instead: smtps://user:pass@mail.example.com:465
SMTP_URL=
MAIL_FROM="Starring <hello@starring.dev>"
# true = no sign-in until the address is confirmed (needs SMTP_URL)
REQUIRE_EMAIL_VERIFICATION=false

# ---- operator & moderation ----------------------------------------------
# Shown on /terms and /privacy (you are the GDPR controller for your instance)
OPERATOR_NAME=
OPERATOR_EMAIL=
OPERATOR_ADDRESS=
OPERATOR_COUNTRY=
# Can open /admin, hide reported profiles, get report emails, and claim blocked handles
ADMIN_EMAILS=
# Extra handles nobody may claim (brands, your company…), comma-separated
BLOCKED_HANDLES=

# ---- optional: analytics -------------------------------------------------
# Plausible script URL (https://…/js/….js). Leave empty for no analytics.
PLAUSIBLE_SRC=
# Show profile owners their own visitor numbers on /account (read from the Plausible above
# via its Stats API). Create a key in Plausible → Settings → API keys (Stats API).
PLAUSIBLE_API_KEY=
# Defaults: the PLAUSIBLE_SRC host, and the hostname of SITE_URL / BETTER_AUTH_URL
PLAUSIBLE_API_HOST=
PLAUSIBLE_SITE_ID=

# ---- optional: sign in with GitHub / GitLab --------------------------------
# GitHub OAuth app callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitLab application callback: <BETTER_AUTH_URL>/api/auth/callback/gitlab  (scopes: read_user)
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Self-hosted GitLab? Set its URL.
GITLAB_ISSUER=https://gitlab.com
